# Exemplo para o proxy ja existente. Ajustar caminhos reais do certificado.
# O certificado precisa cobrir minifabrica.kronux.com.br.
server {
    listen 80;
    server_name minifabrica.kronux.com.br;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name minifabrica.kronux.com.br;
    ssl_certificate /etc/letsencrypt/live/minifabrica.kronux.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/minifabrica.kronux.com.br/privkey.pem;
    client_max_body_size 90m;
    location / {
        proxy_pass http://127.0.0.1:8004;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
