FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 YOLO_CONFIG_DIR=/tmp/ultralytics
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system minifabrica && adduser --system --ingroup minifabrica minifabrica
COPY requirements.txt requirements-yolo.txt ./
RUN pip install --no-cache-dir torch==2.9.1+cpu torchvision==0.24.1+cpu --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements-yolo.txt
COPY backend ./backend
COPY database ./database
RUN mkdir -p /app/data/uploads /models && chown -R minifabrica:minifabrica /app
USER minifabrica
CMD ["python", "-m", "backend.app.yolo_worker"]
